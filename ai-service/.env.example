# Application
APP_NAME=Visual Search AI Service
APP_VERSION=1.0.0
DEBUG=false

# SigLIP
SIGLIP_MODEL=google/siglip2-base-patch16-224

# EasyOCR
OCR_LANGUAGES=vi,en

# Shared upload and execution limits
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_IMAGE_PIXELS=25000000
MAX_BATCH_IMAGES=20
MAX_ACTIVE_PROCESSING=3
MAX_WAITING_REQUESTS=6
SEARCH_RESERVED_WAITING=2
MAX_QUEUE_WAIT_SECONDS=60
EMBEDDING_MICROBATCH_SIZE=2

# Device
DEVICE=cpu

# CPU threads (0 chooses Torch threads from available CPU resources)
TORCH_NUM_THREADS=0
TORCH_NUM_INTEROP_THREADS=1
OPENCV_NUM_THREADS=1

# Model cache (defaults to ~/.cache; Docker uses /root/.cache)
# MODEL_CACHE_DIR=./models

# ==========================================
# Environment Variables Configuration
# ==========================================

# --- PostgreSQL ---
POSTGRES_DB=visual_search_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5432

# --- Qdrant Vector DB ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=images
QDRANT_VECTOR_SIZE=768

# --- MinIO Object Storage ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_IMAGES=images
MINIO_BUCKET_THUMBNAILS=thumbnails

# --- RabbitMQ Message Broker ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_QUEUE_IMAGE_UPLOADED=image.uploaded.queue
RABBITMQ_QUEUE_IMAGE_INDEXED=image.indexed.queue
RABBITMQ_EXCHANGE=visual.search.exchange
RABBITMQ_ROUTING_KEY_UPLOADED=image.uploaded
RABBITMQ_ROUTING_KEY_INDEXED=image.indexed

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_for_security
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI Service (FastAPI) ---
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
SIGLIP_MODEL_NAME=google/siglip-base-patch16-224
EASYOCR_LANGUAGES=en,vi

# --- Frontend (React) ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api/v1

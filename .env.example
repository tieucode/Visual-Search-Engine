# ==========================================
# Environment Variables Configuration
# ==========================================

# --- PostgreSQL ---
POSTGRES_DB=visual_search_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5432

# --- Qdrant Vector DB ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=images
QDRANT_VECTOR_SIZE=768
QDRANT_CONNECT_TIMEOUT=3s
QDRANT_REQUEST_TIMEOUT=10s

# --- MinIO Object Storage ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_IMAGES=images
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=604800

# --- RabbitMQ Message Broker ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_QUEUE_IMAGE_UPLOADED=image.uploaded.queue
RABBITMQ_EXCHANGE=visual.search.exchange
RABBITMQ_ROUTING_KEY_UPLOADED=image.uploaded
RABBITMQ_RETRY_EXCHANGE=visual.search.retry.exchange
RABBITMQ_RETRY_QUEUE=image.uploaded.retry.15m.queue
RABBITMQ_RETRY_ROUTING_KEY=image.uploaded.retry
RABBITMQ_DLX_EXCHANGE=visual.search.dlq.exchange
RABBITMQ_DLQ=image.uploaded.dlq
RABBITMQ_DLQ_ROUTING_KEY=image.uploaded.dlq
RABBITMQ_PUBLISHER_CONFIRM_TIMEOUT=5s
RABBITMQ_PUBLISHER_CONFIRM_TIMEOUT_MS=5000

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_for_security
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI Service (FastAPI) ---
AI_SERVICE_PORT=8000
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_SERVICE_CONNECT_TIMEOUT=3s
AI_SERVICE_TIMEOUT=60s
AI_HEALTH_PATH=/health
SIGLIP_MODEL_NAME=google/siglip-base-patch16-224
EASYOCR_LANGUAGES=en,vi

# --- Indexing Service ---
INDEXING_SERVICE_PORT=8081
INDEXING_MAX_RETRIES=3
INDEXING_RETRY_DELAY=15m
INDEXING_MAX_IMAGE_BYTES=20971520
INDEXING_MAX_IMAGE_PIXELS=40000000
INDEXING_MAX_IMAGE_DIMENSION=1024
INDEXING_MAX_BATCH_IMAGES=20
INDEXING_ALLOWED_IMAGE_HOSTS=minio,localhost
INDEXING_IMAGE_CONNECT_TIMEOUT=3s
INDEXING_IMAGE_REQUEST_TIMEOUT=30s
INDEXING_SHUTDOWN_TIMEOUT=60s
AI_HEALTH_CHECK_INTERVAL=30s
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_DURATION=60s
QDRANT_BASE_URL=http://qdrant:6333

# --- Frontend (React) ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api
